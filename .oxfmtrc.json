{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "singleQuote": true,
  "printWidth": 80,
  "sortPackageJson": false,
  "ignorePatterns": [
    "package-lock.json",
    "pnpm-lock.yaml",
    "yarn.lock",
    "bun.lock",
    "bun.lockb",
    "data/raw/**",
    "data/catalog*.json",
    "data/story-observations.json",
    "public/catalog.json",
    "public/coverage.json",
    "public/*.geojson"
  ]
}
